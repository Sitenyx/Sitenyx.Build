<!-- 
  Sitenyx Shared Package Versions
  Repository: https://github.com/reza-ariyan/Sitenyx.Build.git
  
  This file provides centralized package version management across all Sitenyx microservices.
  To use: Add this repo as a git submodule and import via Directory.Build.props
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- ============================================ -->
    <!-- Azure Packages -->
    <!-- ============================================ -->
    <PackageVersion Include="AspNetCore.HealthChecks.Rabbitmq" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <PackageVersion Include="Azure.Core" Version="1.50.0" />
    <PackageVersion Include="Azure.Identity" Version="1.17.1" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.3.2" />
    <!-- ============================================ -->
    <!-- Testing Packages -->
    <!-- ============================================ -->
    <PackageVersion Include="Coverlet.Collector" Version="10.0.0" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Microsoft.TestPlatform.AdapterUtilities" Version="18.0.1" />
    <PackageVersion Include="Microsoft.TestPlatform.ObjectModel" Version="18.0.1" />
    <PackageVersion Include="Microsoft.TestPlatform.TestHost" Version="18.0.1" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="NJsonSchema" Version="11.5.2" />
    <PackageVersion Include="NUnit" Version="4.4.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.11.2" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.1.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.13.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Respawn.Postgres" Version="1.0.15" />
    <PackageVersion Include="XUnit" Version="2.9.3" />
    <PackageVersion Include="XUnit.Runner.Visualstudio" Version="3.1.5" />
    <!-- ============================================ -->
    <!-- Core Application Packages -->
    <!-- ============================================ -->
    <PackageVersion Include="FluentResults" Version="4.0.0" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="MediatR" Version="14.2.0" />
    <!-- ============================================ -->
    <!-- Entity Framework & Database -->
    <!-- ============================================ -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.DependencyInjection" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- ============================================ -->
    <!-- ASP.NET Core -->
    <!-- ============================================ -->
    <PackageVersion Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.UI" Version="8.0.8" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Http" Version="2.2.2" />
    <!-- ============================================ -->
    <!-- Configuration & Extensions -->
    <!-- ============================================ -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <!-- ============================================ -->
    <!-- AI / Microsoft Agent Framework (MAF migration) -->
    <!-- ============================================ -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.17.0" />
    <!-- ============================================ -->
    <!-- API Documentation -->
    <!-- ============================================ -->
    <!-- Microsoft.OpenApi: pulled TRANSITIVELY by Swashbuckle/NSwag/AspNetCore.OpenApi at 2.4.1
         (CVE-2026-49451, GHSA-v5pm-xwqc-g5wc, High), which wins over a plain central pin because
         transitive pinning is off. Forced to the patched 2.12.0 as a real direct PackageReference in
         the platform-wide ItemGroup below (NOT GlobalPackageReference — that sets PrivateAssets=all,
         which starves the Microsoft.AspNetCore.OpenApi XML-comment source-generator of the compile
         assets it needs in SDK class-libs → CS0012/CS0246 pack failures). Clears the E3 vuln audit.

         CEILED AT 2.x — do NOT take the 3.x line that Dependabot and `dotnet list package` offer
         (3.10.0 at time of writing). Two independent blocks, both measured 2026-08-13:
           1. Microsoft.AspNetCore.OpenApi 10.0.11 declares Microsoft.OpenApi (>= 2.7.5 && < 3.0.0) —
              an EXCLUSIVE upper bound. Forcing 3.10.0 restores, but warns NU1608 on every project.
           2. It then FAILS the build outright. ASP.NET Core's own XML-comment source generator emits
              `mediaType.Example = ...` into OpenApiXmlCommentSupport.generated.cs; 3.x made
              IOpenApiMediaType.Example read-only, so the generated file no longer compiles:
              `error CS0200: Property or indexer 'IOpenApiMediaType.Example' cannot be assigned to`
              (x2, Core.csproj). No source-level fix exists on our side — the broken code is generated.
         2.12.0 is the newest release inside the framework's range and carries the CVE fix.
         Revisit only when a Microsoft.AspNetCore.OpenApi ships whose range admits 3.x. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.0" />

    <PackageVersion Include="NSwag.AspNetCore" Version="14.1.0" />
    <PackageVersion Include="NSwag.MSBuild" Version="14.1.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.18" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.1.7" />
    <PackageVersion Include="Swashbuckle.AspNetCore.Annotations" Version="10.2.3" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerGen" Version="6.9.0" />
    <!-- ============================================ -->
    <!-- OpenIddict Authentication (v7.1.0) -->
    <!-- Note: All services now use v7.x for consistency with Core -->
    <!-- ============================================ -->
    <PackageVersion Include="OpenIddict.Abstractions" Version="7.6.0" />
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.6.0" />
    <PackageVersion Include="OpenIddict.Core" Version="7.6.0" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.6.0" />
    <PackageVersion Include="OpenIddict.Server" Version="7.6.0" />
    <PackageVersion Include="OpenIddict.Server.AspNetCore" Version="7.6.0" />
    <PackageVersion Include="OpenIddict.Validation.AspNetCore" Version="7.6.0" />
    <PackageVersion Include="OpenIddict.Validation.SystemNetHttp" Version="7.6.0" />
    <!-- ============================================ -->
    <!-- Logging & Monitoring -->
    <!-- ============================================ -->
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Expressions" Version="5.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
    <PackageVersion Include="Datadog.Trace" Version="3.51.1" />
    <!-- ============================================ -->
    <!-- OpenTelemetry / Prometheus Metrics -->
    <!-- ============================================ -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.15.3-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <!-- ============================================ -->
    <!-- Utilities & Helpers -->
    <!-- ============================================ -->
    <PackageVersion Include="Ardalis.GuardClauses" Version="5.0.0" />
    <PackageVersion Include="AutoMapper" Version="16.2.0" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="Polly" Version="8.7.0" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.2" />
    <PackageVersion Include="System.Formats.Asn1" Version="10.0.0" />
    <PackageVersion Include="System.Linq.Async" Version="7.0.1" />
    <PackageVersion Include="System.Text.Json" Version="10.0.0" />
    <!-- PDF + image diffing (used by Core.Testing.Assertions.PdfAssertions) -->
    <PackageVersion Include="PdfPig" Version="0.1.14" />
    <PackageVersion Include="QuestPDF" Version="2026.7.3" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.84.0" />
    <!-- ============================================ -->
    <!-- Multi-Tenancy -->
    <!-- ============================================ -->
    <PackageVersion Include="Finbuckle.MultiTenant" Version="10.1.3" />
    <PackageVersion Include="Finbuckle.MultiTenant.AspNetCore" Version="10.1.3" />
    <PackageVersion Include="Finbuckle.MultiTenant.EntityFrameworkCore" Version="10.1.3" />
    <PackageVersion Include="Finbuckle.MultiTenant.Abstractions" Version="10.1.3" />
    <!-- ============================================ -->
    <!-- Service Discovery & Gateway -->
    <!-- ============================================ -->
    <PackageVersion Include="Consul" Version="1.7.14.11" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="Steeltoe.Discovery.Consul" Version="4.2.0" />
    <PackageVersion Include="Steeltoe.Discovery.HttpClients" Version="4.2.0" />
    <!-- ============================================ -->
    <!-- Message Bus (Rebus) -->
    <!-- ============================================ -->
    <PackageVersion Include="Rebus" Version="8.9.2" />
    <PackageVersion Include="Rebus.PostgreSql" Version="9.1.1" />
    <PackageVersion Include="Rebus.RabbitMq" Version="10.1.1" />
    <PackageVersion Include="Rebus.Serilog" Version="8.1.0" />
    <PackageVersion Include="Rebus.ServiceProvider" Version="10.7.2" />
    <!-- ============================================ -->
    <!-- Caching & Distributed Locking -->
    <!-- ============================================ -->
    <PackageVersion Include="StackExchange.Redis" Version="3.1.13" />
    <PackageVersion Include="DistributedLock.Redis" Version="1.1.1" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.11" />
    <!-- ============================================ -->
    <!-- Roslyn Analyzer (Sitenyx.Analyzers package distribution) -->
    <!-- Pinned to 4.8.0 — highest stable that loads in VS 17.8 / Rider 2024 / dotnet 8+ -->
    <!-- ============================================ -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0" />
    <!-- UNHELD 2026-08-13: now on 1.1.2 (test-harness only; no CVE, no runtime impact).
         The 1.1.1 hold existed because 1.1.2 tightened the CodeAnalysis.Testing FixEach locality
         check to reject a code fix whose edit lands outside the triggering diagnostic's span,
         which failed SubscribeMatrix's cross-document (DI-file) and file-level-marker fixes
         (`System.InvalidOperationException : Code fix is attempting to provide a fix for a
         non-local analyzer diagnostic`, 2 of 87 tests). The note that there was no clean opt-out
         was wrong: 1.1.2 shipped the assertion AND its escape hatch together, and
         CodeFixTestBehaviors.SkipLocalDiagnosticCheck (new in 1.1.2, absent from 1.1.1) is it.
         Both tests in Core's tests/Sitenyx.Analyzers.Tests/SubscribeMatrixCodeFixProviderTests.cs
         now declare it — SX0005 is a compilation-end diagnostic, so non-local is correct and
         intended, not a defect being papered over. Verified 87/87 green. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.XUnit" Version="1.1.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing.XUnit" Version="1.1.2" />
    <!-- ============================================ -->
    <!-- Sitenyx Internal - Core & Contracts -->
    <!-- ============================================ -->
    <PackageVersion Include="Sitenyx.Core" Version="1.26.237.126" />
    <PackageVersion Include="Sitenyx.Shared" Version="1.26.237.126" />
    <PackageVersion Include="Sitenyx.Core.Testing" Version="1.26.237.126" />
    <!-- Security override. GHSA-q939-rpr3-3284 (High, 2026-08-12): SSH.NET 2025.1.0
         ScpClient recursive download allows arbitrary file write via server-controlled SCP
         filenames. It reaches every service transitively and test-only, through
         Sitenyx.Core.Testing to Testcontainers 4.13.0 to SSH.NET 2025.1.0, so no shipped
         service carries it in a runtime graph. The CI vulnerability audit walks test
         projects, so it turned the whole fleet's Deploy red at once. Testcontainers 4.13.0
         is the newest release and still resolves the vulnerable version.
         This version alone does NOT bind: CentralPackageTransitivePinningEnabled is off
         platform-wide, the same reason RabbitMQ.Client and Microsoft.OpenApi are forced
         with direct references. Each Sitenyx.Core.Testing consumer carries a paired
         versionless PackageReference for SSH.NET; NuGet highest-wins then lifts
         Testcontainers' demand to the patched version. Remove both halves once
         Testcontainers' own floor passes SSH.NET 2026.0.0. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!--
      Sitenyx.Analyzers — pinned via GlobalPackageReference below (NOT a plain
      PackageVersion). The autoflow in build-and-update-sdks.sh updates the
      Version attribute inside the <GlobalPackageReference> block on each Core
      trio publish.
    -->
    <!-- ============================================ -->
    <!-- Sitenyx Internal - Gate Sdks & Contracts -->
    <!-- Note: Gate Sdks/Contracts are defined in each service's local Directory.Packages.props -->
    <!--       based on their specific dependencies. This keeps dependency management explicit. -->
    <!-- ============================================ -->
  </ItemGroup>
  <!-- ================================================================================== -->
  <!-- Sitenyx.Analyzers — platform-wide auto-wiring via GlobalPackageReference            -->
  <!--                                                                                    -->
  <!-- Without this block the analyzer NuGet stays unreferenced and SX0005/006/076/077/   -->
  <!-- 078/080/082 silently DO NOT FIRE on consumer projects. GlobalPackageReference      -->
  <!-- (NuGet CPM, SDK 6.0+) is the canonical CPM wiring for a package that EVERY         -->
  <!-- project in scope should consume — it bundles the version pin AND the implicit      -->
  <!-- PackageReference, so a plain <PackageVersion Include="Sitenyx.Analyzers"/> sibling -->
  <!-- triggers NU1506 (duplicate PackageVersion) and must NOT coexist.                   -->
  <!--                                                                                    -->
  <!--   PrivateAssets="all" — analyzer DLLs do NOT propagate to consumers of THIS NuGet  -->
  <!--                        (each downstream consumer wires its own analyzers).         -->
  <!--   IncludeAssets="analyzers; build" — load the analyzer DLL + any MSBuild targets   -->
  <!--                        the package ships; explicitly excludes "compile"/"runtime"  -->
  <!--                        (analyzers must never leak into the consumer's runtime).    -->
  <!--                                                                                    -->
  <!-- Opt-out: set <UsesSitenyxAnalyzers>false</UsesSitenyxAnalyzers> in the csproj      -->
  <!-- PropertyGroup. Required for the 3 self-referential projects inside the Core repo:  -->
  <!--   - Core/Sitenyx.Analyzers/Sitenyx.Analyzers.csproj                                -->
  <!--   - Core/Sitenyx.Analyzers.CodeFixes/Sitenyx.Analyzers.CodeFixes.csproj            -->
  <!--   - Core/tests/Sitenyx.Analyzers.Tests/Sitenyx.Analyzers.Tests.csproj              -->
  <!-- They ProjectReference the analyzer source directly and must not pull the NuGet.    -->
  <!-- ================================================================================== -->
  <ItemGroup Condition="'$(UsesSitenyxAnalyzers)' != 'false'">
    <GlobalPackageReference Include="Sitenyx.Analyzers" Version="1.26.237.126" PrivateAssets="all" IncludeAssets="analyzers; build" />
  </ItemGroup>
  <!-- Microsoft.OpenApi — forced to the CVE-2026-49451-patched 2.12.0 across ALL projects via a real
       direct PackageReference (version from the central PackageVersion above). This overrides the
       vulnerable 2.4.1 that Swashbuckle/NSwag/AspNetCore.OpenApi pull transitively (transitive pinning
       is off; a plain PackageVersion alone does not win). A direct ref (compile+runtime assets flowing)
       is used — NOT GlobalPackageReference, whose PrivateAssets=all breaks the AspNetCore.OpenApi
       source-generator in SDK class-libs. This file is imported into each service's Directory.Build.props,
       so the reference applies platform-wide. Clears the E3 vuln-audit CI gate. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.OpenApi" />
  </ItemGroup>
</Project>